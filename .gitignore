/workspace/*
!/workspace/MATH/
/workspace/MATH/*
!/workspace/MATH/operator_library/
!/workspace/MATH/operator_library/**
/workspace/MATH/operator_library/**/__pycache__/
/workspace/MATH/operator_library/**/*.pyc
